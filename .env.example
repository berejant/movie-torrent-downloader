# Copy to .env and fill in. Keep .env out of version control.
#
# Locally (go run ./cmd/server) this file is loaded automatically by godotenv.
# In Docker the same file is passed with env_file / --env-file. Real
# environment variables always win over the values here.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

HTTP_PORT=8080

# Where .torrent files are written. Inside the container this is the mount
# point; on the host it is whatever your download client watches.
TORRENT_FILES_DIR=/torrents

# SQLite database file. Must live on a mounted volume to survive a redeploy.
DB_PATH=/data/app.db

# Display timezone. Timestamps are always stored in UTC.
TZ=Europe/Kyiv

# debug | info | warn | error
LOG_LEVEL=info

# Maximum titles accepted in one batch submission.
BATCH_MAX_LINES=100

# HTTP basic auth for the UI. Both must be set to enable it; leave both empty
# for an unauthenticated LAN-only deployment.
AUTH_USER=
AUTH_PASSWORD=

# Set false to disable duplicate rejection globally. Individual requests can
# always be forced from the UI instead.
DUPLICATE_CHECK_ENABLED=true

# Container user. On Synology, set these to the owner of the mounted shares —
# otherwise the container cannot write to them. Find them with `id <user>`.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Tracker
# ---------------------------------------------------------------------------

# Short slug, used in saved filenames: <title>-<tracker>-<quality>-<id>.torrent
TRACKER_NAME=mazepa

TRACKER_BASE_URL=https://mazepa.to
TRACKER_LOGIN=
TRACKER_PASSWORD=

# Lower wins when several trackers are configured (single tracker for now).
TRACKER_PRIORITY=1

# Per-request timeout in seconds.
TRACKER_TIMEOUT_SECONDS=30

# Concurrent workers for this tracker.
TRACKER_WORKERS=5

# Shared request rate across all workers. Raising this makes the service look
# less like a browser and more like a scraper.
TRACKER_RPS=1

# Skip releases larger than this many bytes. 0 = unlimited.
# Example: 64424509440 = 60 GiB
TRACKER_MAX_SIZE_BYTES=0

# Override only if the default Chrome string stops working.
# TRACKER_USER_AGENT=

# Tracker-specific paths, form fields and selectors as a JSON object. Every key
# is optional; unset keys keep the TorrentPier defaults shown here. Set this
# only if mazepa.to changes its markup and the parser stops finding rows.
# TRACKER_EXTRA_OPTIONS={"tracker_path":"/tracker.php","login_path":"/login.php","login_username_field":"login_username","login_password_field":"login_password","login_submit_field":"login","login_submit_value":"Увійти","search_query_field":"nm","logged_in_selector":"a[href*='logout']","logged_out_selector":"#register_link","result_row_selector":"#forum_table tbody tr","topic_link_selector":"a[href*='topic-']","download_link_selector":"a[href*='dl.php?id=']","forum_link_selector":"a[href*='forum-']","size_cell_index":5}

# ---------------------------------------------------------------------------
# Retry policy (transient failures only: network, timeouts, 5xx, 429)
# ---------------------------------------------------------------------------

RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=3
RETRY_MAX_BACKOFF_SECONDS=60
