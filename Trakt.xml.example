<?xml version="1.0" encoding="utf-8"?>
<!--
  Example of the file TRAKT_TOKEN_FILE points at.

  It is written by the Emby/Jellyfin trakt plugin, which owns the OAuth flow and
  refreshes the token in place. This service never writes it: before every sync
  it reads <AccessToken> from the first <TraktUser> that has one, so a refresh on
  the other side is picked up without a restart. Everything else here is the
  plugin's own configuration and is ignored.

  The real file holds live credentials — keep it out of version control and
  mount it read-only.
-->
<PluginConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <TraktUsers>
    <TraktUser>
      <AccessToken>REPLACE_WITH_ACCESS_TOKEN</AccessToken>
      <!-- any other fields are ignored by the service -->
    </TraktUser>
  </TraktUsers>
</PluginConfiguration>
